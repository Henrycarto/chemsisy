8269292282365668856\n13533116 47 18059852861477422727\n13782708 43 17202464750390937823\n13911987 19 18122079838812867708\n14790565 3 17096910401152887893\n15183329 4 18271803502462316973\n15475509 8 18114180771063459589\n15537594 2 17774998033251683054\n17349148 13 16272209699983886733\n20645477 70 18411133615670165718\n21285901 2 18188198828102288453\n21344244 181 18334294241411270747\n21641784 216 16154261703364662789\n235170 7 18041008353659535646\n23557571 272 17241344567537739672\n23559900 14 17676784101619620062\n3004659 81 18342171120873428230\n345986 75 16773792563220483170\n3472631 163 16371010745202935148\n34797466 226 18114176449888379901\n404807 14 17764596413009800503\n4093350 32 18335136531040900269\n46194498 28 18261105262539542788\n58260988 647 18342176618742881199\n59682541 52 18341883083381589029\n960060 61 18413388735150705340\n\n> <PUBCHEM_SHAPE_MULTIPOLES>\n533.78\n15.16\n2.98\n2.18\n14.08\n1.49\n1.31\n2.11\n-9.59\n-6.54\n-1.07\n1.59\n0.04\n1.15\n\n> <PUBCHEM_SHAPE_SELFOVERLAP>\n1124.925\n\n> <PUBCHEM_SHAPE_VOLUME>\n301\n\n> <PUBCHEM_COORDINATE_TYPE>\n2\n5\n10\n\n$$$$\n","conformer":{"source":"PubChem 3D conformer","url":"https://pubchem.ncbi.nlm.nih.gov/compound/5479529#section=3D-Conformer"},"properties":{"weight":424.4,"xlogp":-0.2,"hbd":3,"hba":10,"tpsa":199},"brandList":[{"name":"Zinnat","url":"https://medikamente.basg.gv.at/documents/1-19105__DOTC_FACH_INFO.pdf"}],"product":{"label":"Zinnat 500 mg film-coated tablets","url":"https://medikamente.basg.gv.at/documents/1-19105__DOTC_FACH_INFO.pdf","source":"BASG"},"groups":[{"ruleId":"beta_lactam","name":"β-lactam ring","atoms":[1,9,13,14,15],"ring":[15,14,13,9],"count":1,"term":"beta-lactam","note":{"caption":"The same four-membered cyclic amide as in penicillins, aimed at the same enzymes.","body":["Cephalosporins carry the same β-lactam: an amide whose nitrogen and carbonyl carbon sit in a four-membered ring. It binds covalently to an active-site serine of penicillin-binding proteins, which cross-link the cell wall.","β-Lactamases attack the same bond. Their serine adds to the β-lactam carbonyl to form an acyl-enzyme, which water then hydrolyses, destroying the drug."],"sources":[{"citation":"ChEBI. β-lactam (CHEBI:35627)","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:35627","licence":"CC BY 4.0"},{"citation":"Bush K, Bradford PA. β-Lactams and β-lactamase inhibitors: an overview. Cold Spring Harb Perspect Med 2016;6(8):a025247","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC4968164/","licence":"Free full text"},{"citation":"Tooke CL, Hinchliffe P, Bragginton EC, et al. β-Lactamases and β-lactamase inhibitors in the 21st century. J Mol Biol 2019;431(18):3472-3500","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC6723624/","licence":"CC BY 4.0"}],"review":{"status":"unreviewed"}}},{"ruleId":"dihydrothiazine","name":"Dihydrothiazine ring","atoms":[0,9,13,16,17,18],"ring":[0,18,17,16,9,13],"count":1,"note":{"caption":"Six-membered sulfur ring fused to the β-lactam: the cephalosporin core.","body":["In cephalosporins the β-lactam is fused to a six-membered dihydrothiazine ring instead of the five-membered thiazolidine of penicillins.","Cephalosporins carry two variable side chains, R1 and R2. In cefuroxime they sit at position 7 (the furyl methoxyimino acetamido chain) and position 3 (a carbamoyloxymethyl group)."],"sources":[{"citation":"Tooke CL, Hinchliffe P, Bragginton EC, et al. β-Lactamases and β-lactamase inhibitors in the 21st century. J Mol Biol 2019;431(18):3472-3500","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC6723624/","licence":"CC BY 4.0"},{"citation":"ChEBI. cephalosporin (CHEBI:23066)","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:23066","licence":"CC BY 4.0"},{"citation":"ChEBI. cefuroxime (CHEBI:3515)","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3515","licence":"CC BY 4.0"},{"citation":"Chaudhry SB, Veve MP, Wagner JL. Cephalosporins: a focus on side chains and β-lactam cross-reactivity. Pharmacy 2019;7(3):103","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC6789778/","licence":"CC BY 4.0"}],"review":{"status":"unreviewed"}}},{"ruleId":"carbamate","name":"Carbamate","atoms":[2,8,12,19,24],"ring":[],"count":1},{"ruleId":"carboxylic_acid","name":"Carboxylic acid","atoms":[3,4,16,20],"ring":[],"count":1,"term":"ionisable","note":{"caption":"Carboxylic acid on the six-membered ring; a contact point for β-lactamases.","body":["Cefuroxime's systematic name ends in a 4-carboxylic acid: the carboxyl group sits directly on the six-membered ring of the cephalosporin core, much as penicillins carry one on their five-membered ring.","β-Lactamases make contact with it: in zinc-dependent enzymes, structural studies describe the substrate carboxylate interacting with an active-site zinc ion."],"sources":[{"citation":"ChEBI. cefuroxime (CHEBI:3515)","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3515","licence":"CC BY 4.0"},{"citation":"Tooke CL, Hinchliffe P, Bragginton EC, et al. β-Lactamases and β-lactamase inhibitors in the 21st century. J Mol Biol 2019;431(18):3472-3500","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC6723624/","licence":"CC BY 4.0"}],"review":{"status":"unreviewed"}}},{"ruleId":"amide","name":"Amide","atoms":[5,10,21,22],"ring":[],"count":1,"note":{"caption":"Position 7 side chain with a methoxyimino group, built to resist β-lactamases.","body":["The side chain on position 7 is attached through an amide and carries a furan ring and a methoxyimino group. Changes at position 7 are what separate cephalosporins by spectrum.","Oxyimino side chains were introduced to counter β-lactamase resistance, and cefuroxime was described from the start as having increased β-lactamase stability."],"sources":[{"citation":"ChEBI. cefuroxime (CHEBI:3515)","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:3515","licence":"CC BY 4.0"},{"citation":"Chaudhry SB, Veve MP, Wagner JL. Cephalosporins: a focus on side chains and β-lactam cross-reactivity. Pharmacy 2019;7(3):103","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC6789778/","licence":"CC BY 4.0"},{"citation":"Tooke CL, Hinchliffe P, Bragginton EC, et al. β-Lactamases and β-lactamase inhibitors in the 21st century. J Mol Biol 2019;431(18):3472-3500","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC6723624/","licence":"CC BY 4.0"},{"citation":"O'Callaghan CH, et al. Cefuroxime, a new cephalosporin antibiotic: activity in vitro. Antimicrob Agents Chemother 1976;9(3):511-519","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC429562/","licence":"Free full text"}],"review":{"status":"unreviewed"}}}],"pubchemUrl":"https://pubchem.ncbi.nlm.nih.gov/compound/5479529"}