66172825511966117\n23558518 356 18116719710367059605\n23559900 14 18342182142039331580\n244849 19 17632024083207604950\n3052486 1 18187367653526091798\n3383291 50 18412262840156262115\n338550 245 18188503461954186941\n4073 2 18342173371842278224\n4340502 62 18270677558888766304\n508706 21 18412828005542778750\n5104073 3 18339632430456495568\n5385378 56 17833839270608933785\n563151 97 17246416756274306197\n57527293 21 17967801770324704544\n6443956 14 17760370285654894031\n653340 110 18340204184459643074\n9777508 108 18412262830743180067\n\n> <PUBCHEM_SHAPE_MULTIPOLES>\n578.08\n12.29\n5.44\n1.36\n1.72\n4.72\n0.1\n-3.03\n-3.28\n-10.29\n-0.23\n1.58\n-0.54\n0.19\n\n> <PUBCHEM_SHAPE_SELFOVERLAP>\n1208.472\n\n> <PUBCHEM_SHAPE_VOLUME>\n327.9\n\n> <PUBCHEM_COORDINATE_TYPE>\n2\n5\n10\n\n$$$$\n","conformer":{"source":"PubChem 3D conformer","url":"https://pubchem.ncbi.nlm.nih.gov/compound/5362129#section=3D-Conformer"},"properties":{"weight":416.5,"xlogp":1.4,"hbd":2,"hba":6,"tpsa":95.9},"brandList":[{"name":"Tritace","url":"https://medikamente.basg.gv.at/documents/1-20028__DOTC_FACH_INFO.pdf"}],"product":{"label":"Tritace 5 mg tablets","url":"https://medikamente.basg.gv.at/documents/1-20028__DOTC_FACH_INFO.pdf","source":"BASG"},"groups":[{"ruleId":"proline_like","name":"Proline-like ring with carboxylic acid","atoms":[1,2,5,7,8,9,12,15],"ring":[5,8,7,9,12],"count":1,"note":{"caption":"A bicyclic proline analogue: a cyclopentane ring fused onto the proline ring.","body":["Ramipril keeps the carboxylic acid of a proline-type ring but adds a fused cyclopentane, giving a bicyclic azabicycloalkane. In the C-domain of ACE, this larger hydrophobic end makes extra contacts with Val379 and Val380, one reason ramipril binds that domain more tightly than enalapril."],"sources":[{"citation":"Zheng W, Tian E, Liu Z, et al. Small molecule angiotensin converting enzyme inhibitors: a medicinal chemistry perspective. Front Pharmacol. 2022;13:968104","url":"https://www.frontiersin.org/journals/pharmacology/articles/10.3389/fphar.2022.968104/full","licence":"CC BY"},{"citation":"ChEBI. Ramipril (CHEBI:8774). European Bioinformatics Institute","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8774","licence":"CC BY 4.0"}],"review":{"status":"unreviewed"}}},{"ruleId":"ester","name":"Ester","atoms":[3,4,18,20,25],"ring":[],"count":1,"term":"prodrug","note":{"caption":"An ethyl ester makes ramipril a prodrug, hydrolysed to the active ramiprilat.","body":["Ramipril carries one of its two carboxylic acids as an ethyl ester. Hydrolysis of this ester produces ramiprilat, the active metabolite, so ramipril is classed as a prodrug.","Unmasking the acid matters because ACE inhibitors of this family bind the zinc ion of the enzyme's active site through a carboxyl group."],"sources":[{"citation":"ChEBI. Ramipril (CHEBI:8774). European Bioinformatics Institute","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8774","licence":"CC BY 4.0"},{"citation":"Zheng W, Tian E, Liu Z, et al. Small molecule angiotensin converting enzyme inhibitors: a medicinal chemistry perspective. Front Pharmacol. 2022;13:968104","url":"https://www.frontiersin.org/journals/pharmacology/articles/10.3389/fphar.2022.968104/full","licence":"CC BY"}],"review":{"status":"unreviewed"}}},{"ruleId":"amide","name":"Amide","atoms":[0,5,14,16],"ring":[],"count":1,"note":{"caption":"The amide makes ramipril a dipeptide, like enalapril.","body":["An amide joins the alanine unit to the nitrogen of the bicyclic ring, so ChEBI classes ramipril as a dipeptide. Structurally, ramipril is enalapril with an extra cyclopentane ring, and this peptide-like backbone is shared by both."],"sources":[{"citation":"ChEBI. Ramipril (CHEBI:8774). European Bioinformatics Institute","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8774","licence":"CC BY 4.0"},{"citation":"Zheng W, Tian E, Liu Z, et al. Small molecule angiotensin converting enzyme inhibitors: a medicinal chemistry perspective. Front Pharmacol. 2022;13:968104","url":"https://www.frontiersin.org/journals/pharmacology/articles/10.3389/fphar.2022.968104/full","licence":"CC BY"}],"review":{"status":"unreviewed"}}},{"ruleId":"secondary_amine","name":"Secondary amine","atoms":[6,16,18],"ring":[],"count":1,"term":"ionisable","note":{"caption":"A basic NH sits beside the acids, so ramipril is both a Brønsted acid and base.","body":["The secondary amine connects the ester-bearing phenylbutanoate side chain to the alanine of the dipeptide, in the same position as in enalapril. With this amine and a free carboxylic acid in one molecule, ChEBI lists ramipril as both a Brønsted acid and a Brønsted base."],"sources":[{"citation":"ChEBI. Ramipril (CHEBI:8774). European Bioinformatics Institute","url":"https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:8774","licence":"CC BY 4.0"},{"citation":"Zheng W, Tian E, Liu Z, et al. Small molecule angiotensin converting enzyme inhibitors: a medicinal chemistry perspective. Front Pharmacol. 2022;13:968104","url":"https://www.frontiersin.org/journals/pharmacology/articles/10.3389/fphar.2022.968104/full","licence":"CC BY"}],"review":{"status":"unreviewed"}}}],"pubchemUrl":"https://pubchem.ncbi.nlm.nih.gov/compound/5362129"}