{
  "name": "chemsisy",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source molecule explorer for pharmacy and medical students.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data": "node --experimental-strip-types scripts/build-data.ts",
    "check": "node scripts/check-privacy.mjs && node scripts/check-house-rules.mjs",
    "size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "3dmol": "2.5.5",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rdkit/rdkit": "2026.9.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  }
}
